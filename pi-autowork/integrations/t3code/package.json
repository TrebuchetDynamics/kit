    "pretest": "npm run build"
  },
  "devDependencies": {
    "@t3tools/plugin-sdk": "file:.sdk",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "react": "19.1.0",
    "typescript": "5.9.3",
    "vite": "8.1.0",
    "react-test-renderer": "https://registry.npmjs.org/react-test-renderer/-/react-test-renderer-19.1.0.tgz"
  },
  "overrides": {
    "rolldown": "1.1.5",
    "react-is": "https://registry.npmjs.org/react-is/-/react-is-19.3.1.tgz",
    "scheduler": "https://registry.npmjs.org/scheduler/-/scheduler-0.26.0.tgz"
  }
