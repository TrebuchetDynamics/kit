{
  "name": "autowork-t3code-experimental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "t3-plugin.json",
    "server.cjs",
    "core.cjs",
    "rpc.ts",
    "dist/web.js",
    "README.md",
    "sdk-source.json",
    "LICENSE",
    "T3-SDK-LICENSE"
  ],
  "scripts": {
    "sdk:fetch": "node scripts/fetch-sdk.mjs",
