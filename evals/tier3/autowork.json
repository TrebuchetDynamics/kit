{
  "skill": "autowork",
  "tier": 3,
  "description": "Execution trace: read the task, run a check, write scoped work, finish.",
  "require": [
    {
      "event": "read",
      "path": "tasks/items/*.md"
    },
    {
      "event": "command",
      "command": "(scripts/check\\.py|pytest|unittest|npm test|go test)",
      "exit": 0
    },
    {
      "event": "write",
      "path": "*"
    },
    {
      "event": "final"
    }
  ],
  "forbid": [
    {
      "event": "command",
      "command": "git (push --force|reset --hard|clean -fd)"
    }
  ]
}
