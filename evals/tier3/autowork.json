{
  "skill": "autowork",
  "tier": 3,
  "description": "Configured deployment observation: inspect GitHub and Orbi, report evidence without executing work.",
  "require": [
    {
      "event": "command",
      "command": "\\bgh\\s+(?:issue|pr)\\s+(?:list|view)\\b",
      "exit": 0
    },
    {
      "event": "command",
      "command": "\\borbi\\s+(?:status|doctor)\\b",
      "exit": 0
    },
    {
      "event": "final"
    }
  ],
  "forbid": [
    {
      "event": "command",
      "command": "\\bgit\\b(?:\\s+(?:-[Cc]|--git-dir|--work-tree|--namespace)\\s+\\S+|\\s+--?[^\\s]+)*\\s+(?:push\\s+(?:--force|-f)|reset\\s+--hard|clean\\s+-[a-z]*(?:f[a-z]*d|d[a-z]*f))(?=\\s|$)"
    },
    {
      "event": "command",
      "command": "\\borbi\\s+(?!(?:status|doctor|check|--help|--version)(?:\\s|$))\\S+|\\bsystemctl\\b.*\\b(?:start|restart|enable|try-restart|reload-or-restart)\\b.*(?:orbi|pi-autowork)"
    },
    {
      "event": "edit",
      "path": "*"
    },
    {
      "event": "write",
      "path": "*"
    },
    {
      "event": "command",
      "command": "\\bautowork\\s+(?:start|resume|run|restart|tasks)\\b|\\bpi-autowork\\.sh\\b|\\bsystemctl\\b.*\\b(?:start|restart)\\b.*pi-autowork"
    }
  ]
}
