{
  "skill": "push",
  "tier": 3,
  "description": "Synthetic invoking-checkout delivery pilot, not model adherence or observed command counts. Scope guards recognize known fixture roots/tip, not arbitrary path roles; read-only clauses are applied separately.",
  "require": [
    {
      "event": "read",
      "path": "*"
    },
    {
      "event": "command",
      "command": "\\bgit\\s+rev-parse\\s+--show-toplevel\\b",
      "exit": 0
    },
    {
      "event": "command",
      "command": "git status",
      "exit": 0
    },
    {
      "event": "command",
      "command": "git diff",
      "exit": 0
    },
    {
      "event": "final",
      "contains": [
        "Local scope:",
        "other worktrees were not inspected",
        "Local commits:",
        "Incoming landed:",
        "Pending:",
        "Selected/final:",
        "Checks:",
        "Remote inclusion:",
        "Local sync:"
      ]
    }
  ],
  "forbid": [
    {
      "event": "command",
      "command": "\\bgit\\b(?:\\s+(?:-[Cc]|--git-dir|--work-tree|--namespace)\\s+\\S+|\\s+--?[^\\s]+)*\\s+(?:push\\s+(?:--force|-f)|reset\\s+--hard|clean\\s+-[a-z]*(?:f[a-z]*d|d[a-z]*f))(?=\\s|$)"
    },
    {
      "event": "command",
      "command": "\\bgh\\s+pr\\s+checkout\\b"
    },
    {
      "event": "command",
      "command": "worktree[_-]sweep|git[-_]commit[-_]push\\s+all\\b"
    },
    {
      "event": "command",
      "command": "out-of-scope/|nested-worker(?:[/\\s\\\"\\x27]|$)"
    },
    {
      "event": "command",
      "command": "\\bgit\\b[^;\\n]*\\badd\\s+(?:--\\s+\\.(?:\\s|$)|-A(?:\\s|$))"
    },
    {
      "event": "command",
      "command": "\\b(?:merge|cherry-pick)\\b[^;\\n]*\\b9999999999999999999999999999999999999999\\b"
    },
    {
      "event": "read",
      "path": "*out-of-scope/*"
    },
    {
      "event": "read",
      "path": "*nested-worker*"
    },
    {
      "event": "write",
      "path": "*out-of-scope/*"
    },
    {
      "event": "write",
      "path": "*nested-worker*"
    },
    {
      "event": "edit",
      "path": "*out-of-scope/*"
    },
    {
      "event": "edit",
      "path": "*nested-worker*"
    }
  ]
}
