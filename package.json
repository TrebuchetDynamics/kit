{
  "name": "@trebuchet/kit",
  "version": "0.3.0",
  "bin": {
    "autowork": "pi-autowork/bin/autowork",
    "tx": "tmux/tx"
  },
  "description": "Kit: a toolset of skills for coding agents, with Autowork as its verified runner",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TrebuchetDynamics/kit.git"
  },
  "files": [
    "scripts/autowork_bootstrap.py",
    "pi-autowork/src/autowork_bootstrap.py",
    "pi-autowork/src/pi_autowork/",
    "adapters/",
    "skills/",
    "scripts/pi-autowork.sh",
    "scripts/pi_autowork_touches.py",
    "pi-autowork/pi_autowork/",
    "pi-autowork/engine/",
    "pi-autowork/bin/",
    "pi-autowork/README.md",
    "pi-autowork/task-store.md",
    "!**/__pycache__",
    "LICENSE",
    "README.md",
    "docs/cross-host.md",
    "tmux/",
    "pi-autowork/integrations/paseo/",
    "!**/node_modules"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi.mjs"
    ],
    "skills": [
      "./adapters/skills"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
