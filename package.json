{
  "name": "@trebuchet/kit",
  "version": "0.3.0",
  "bin": {
    "tx": "tmux/tx"
  },
  "description": "Kit: planning skills for coding agents, with GitHub Issues and Orbi delivery",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TrebuchetDynamics/kit.git"
  },
  "files": [
    "scripts/github_issues.py",
    "scripts/worktree_paths.py",
    "scripts/checkout_lock.py",
    "adapters/",
    "skills/",
    "!**/__pycache__",
    "LICENSE",
    "README.md",
    "docs/",
    "tmux/",
    "!**/node_modules"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi.mjs"
    ],
    "skills": [
      "./adapters/skills"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
